# OpenAI (required for rewrite/grammar)
OPENAI_API_KEY=your-key-here

# Supabase (auth + usage + subscriptions)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dodo Payments (subscriptions)
DODO_PAYMENTS_API_KEY=your-dodo-api-key
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_WEBHOOK_SECRET=your-dodo-webhook-signing-secret
DODO_PRODUCT_MONTHLY=pdt_your-monthly-product-id
DODO_PRODUCT_YEARLY=pdt_your-yearly-product-id

# App URL (for checkout redirect; optional, defaults to https://rewordly.store)
NEXT_PUBLIC_APP_URL=https://rewordly.store

# Live check (check-as-you-type) cost control. Requires supabase-live-check.sql.
# Daily spend cap (USD) for free/anonymous live checks; Pro is not affected. 0 disables the cap.
LIVE_CHECK_DAILY_BUDGET_USD=2
# Same for rewrite, grammar and proactive check together (default 2). Pro is never paused.
LEGACY_DAILY_BUDGET_USD=
# Optional salt for hashing IPs used in the anonymous per-IP cap.
IP_HASH_SALT=
# Model that confirms each suggestion before it is shown (default gpt-5-mini). 'off' disables the second pass.
LIVE_CHECK_JUDGE_MODEL=
# Days a cached answer is served before the sentence is checked again (default 30).
CHECK_CACHE_TTL_DAYS=
# How many different people must ignore the same suggestion before it is dropped (default 5, minimum 2).
CHECK_SUPPRESS_MIN_USERS=
