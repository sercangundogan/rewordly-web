# OpenAI (required for rewrite/grammar)
OPENAI_API_KEY=your-key-here

# Supabase (auth + usage + subscriptions)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dodo Payments (subscriptions)
DODO_PAYMENTS_API_KEY=your-dodo-api-key
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_WEBHOOK_SECRET=your-dodo-webhook-signing-secret
DODO_PRODUCT_MONTHLY=pdt_your-monthly-product-id
DODO_PRODUCT_YEARLY=pdt_your-yearly-product-id

# App URL (for checkout redirect; optional, defaults to https://rewordly.store)
NEXT_PUBLIC_APP_URL=https://rewordly.store
