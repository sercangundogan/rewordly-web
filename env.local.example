OPENAI_API_KEY=your-key-here

# LanguageTool API URL
# Public API (ücretsiz, limitli):
# LANGUAGETOOL_API_URL=https://api.languagetool.org/v2/check

# Kendi sunucunuzda barındırıyorsanız (sınırsız, ücretsiz):
# LANGUAGETOOL_API_URL=http://localhost:8081/v2/check
# veya production için:
# LANGUAGETOOL_API_URL=https://languagetool.yourdomain.com/v2/check 